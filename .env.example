# EvidenceGuard Environment Configuration Example
# Copy this file to .env and populate your credentials

# Application
ENVIRONMENT=development
DEBUG=false
APP_NAME="EvidenceGuard RAG"
APP_VERSION="1.0.0"

# LLM Providers (mock, local_hf, openai, gemini, ollama)
DEFAULT_LLM_PROVIDER=mock
LOCAL_MODEL_NAME_OR_PATH="Qwen/Qwen2.5-3B-Instruct"

# Remote API Keys (Optional - only required if provider is set to openai or gemini)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Embeddings & Reranker
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
RERANKER_MODEL_NAME="cross-encoder/ms-marco-MiniLM-L-6-v2"
DEVICE="cuda"

# Retrieval Hyperparameters
DENSE_TOP_K=15
SPARSE_TOP_K=15
RRF_K=60
RERANK_TOP_K=5

# Epistemic Decision Thresholds
SUFFICIENCY_THRESHOLD=0.65
ABSTENTION_THRESHOLD=0.35
CONTRADICTION_THRESHOLD=0.40
ENTAILMENT_THRESHOLD=0.50
MAX_QUERY_RETRY_COUNT=2

# Observability & Tracking
ENABLE_MLFLOW=true
MLFLOW_TRACKING_URI="file:./experiments/mlruns"
ENABLE_LANGSMITH=false
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="evidenceguard-rag"
